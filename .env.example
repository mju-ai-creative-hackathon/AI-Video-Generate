# 이 파일을 .env로 복사해 값을 채운다. .env는 git에서 제외된다.
# 영상 파이프라인(vlog)과 Backend(Spring)가 같은 .env를 읽는다. 각자 자기 키만 쓰고 나머지는 무시한다.

### 영상 파이프라인 (vlog) ###
# vlog serve의 인증 키. 127.0.0.1이 아닌 주소로 열려면 필수다.
API_KEY=
ELEVENLABS_API_KEY=
# 나노바나나 (effect를 지정한 컷). AI Studio에서 발급한다. 유료 결제가 켜져 있어야 한다.
GEMINI_API_KEY=
# Veo (--video veo). 인증은 gcloud auth login으로 한다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
DATABASE_URL=postgresql+psycopg://vlog:vlog@127.0.0.1:5432/vlog
# Ollama와 ComfyUI는 인증이 없으므로 127.0.0.1에만 연다.
OLLAMA_URL=http://127.0.0.1:11434
COMFYUI_URL=http://127.0.0.1:8188

### Backend (Spring) ###
POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Spring을 기본값과 다르게 실행할 때 사용하는 값입니다.
DB_URL=jdbc:postgresql://localhost:5433/hackathon
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
GOOGLE_SERVER_CLIENT_ID=your-web-application-oauth-client-id

# AI 영상 서버(AI-Video-Generate의 vlog serve) 연동. docs/SHORTFORM_API.md 참고.
# 검토 화면이 있는 앱을 배포한 뒤에 true로 켠다.
SHORTFORM_STORAGE_ROOT=./data/shortforms
SHORTFORM_AI_ENABLED=false
# 예: SSH 터널로 VM 호스트의 18000번에 연 경우 http://host.docker.internal:18000/api/v1
SHORTFORM_AI_BASE_URL=
# AI 서버 .env의 API_KEY와 같은 값
SHORTFORM_AI_API_KEY=
SHORTFORM_WORKER_ENABLED=true
SHORTFORM_SUBMIT_TIMEOUT_SECONDS=300
SHORTFORM_DRAFT_TIMEOUT_SECONDS=1800
SHORTFORM_RENDER_TIMEOUT_SECONDS=7200
SHORTFORM_MAX_FAILURES=3
SHORTFORM_DAILY_RENDER_LIMIT=5
SHORTFORM_MEDIA_URL_TTL_SECONDS=3600
