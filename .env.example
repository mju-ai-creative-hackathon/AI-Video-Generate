POSTGRES_DB=hackathon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Spring을 기본값과 다르게 실행할 때 사용하는 값입니다.
DB_URL=jdbc:postgresql://localhost:5433/hackathon
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_SECONDS=3600
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
FRONTEND_OAUTH_SUCCESS_URL=http://localhost:3000/oauth/callback
FRONTEND_OAUTH_FAILURE_URL=http://localhost:3000/login
